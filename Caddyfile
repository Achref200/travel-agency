# Caddy automatically obtains and renews Let's Encrypt certificates for both the
# apex ({$DOMAIN}) and www hosts. Set DOMAIN in your .env (e.g. DOMAIN=example.com).
#
# The canonical host is www (matches NEXT_PUBLIC_SITE_URL=https://www.<domain>),
# so the apex domain issues a 301 redirect to www to avoid duplicate content.

# Apex → www (301 permanent), preserving the path/query.
{$DOMAIN} {
	redir https://www.{$DOMAIN}{uri} permanent
}

# Canonical www host — serves the app.
www.{$DOMAIN} {
	encode zstd gzip

	# Forward everything to the Next.js container. Caddy adds the
	# X-Forwarded-For / X-Forwarded-Proto headers the app relies on.
	reverse_proxy app:3000

	# Long-lived immutable Next.js assets.
	@static path /_next/static/* /favicon.ico /icon /manifest.webmanifest
	header @static Cache-Control "public, max-age=31536000, immutable"
}
