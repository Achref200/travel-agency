# ── Local development environment ──────────────────────────────────────────
# Copy to `.env` and fill in. Never commit real secrets.

# Database (Use a MySQL URL for local dev and production)
DATABASE_URL="mysql://user:password@localhost:3306/travel_agency"

# Public site URL (used for canonical URLs, sitemaps, OG tags)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cloudinary — required for the admin image upload flow.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
# Required together with the cloud name. Use an unsigned
# preset restricted to image uploads in your Cloudinary dashboard.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# ── Admin dashboard ─────────────────────────────────────────────────────────
# Seeded into the AdminUser table when you run `npx prisma db seed`.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
# Secret used to sign admin session cookies. Use a long random string.
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"
