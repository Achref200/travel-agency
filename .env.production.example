# ── PRODUCTION ENVIRONMENT (Contabo / Docker Compose) ───────────────────────
# Copy to `.env` on the server, then fill in real values:
#     cp .env.production.example .env
# Keep the resulting `.env` private — it is git-ignored and never baked into
# the Docker image.

# Your apex domain WITHOUT protocol — Caddy uses it for automatic HTTPS and
# redirects it to the www canonical below.
DOMAIN="marwentravel.com"

# Public site URL WITH protocol, no trailing slash. This is the CANONICAL host
# (www). Inlined at build time, so it must be correct before `docker compose build`.
NEXT_PUBLIC_SITE_URL="https://www.marwentravel.com"

# MySQL database URL (replace with your Hostinger or production MySQL credentials)
DATABASE_URL="mysql://user:password@localhost:3306/travel_agency"

# ── Admin account — created / updated automatically on every boot ────────────
ADMIN_EMAIL="marwen-travel@agency.com"
ADMIN_PASSWORD="MarwenTravel@2026"

# Secret that signs admin session cookies. GENERATE A FRESH ONE and keep it
# stable (changing it logs everyone out):
#     openssl rand -base64 48
ADMIN_SESSION_SECRET="REPLACE_WITH_A_LONG_RANDOM_STRING"

# Lead notifications. New and historical bookings/messages are delivered to:
# WhatsApp: +905013476409
# Email: contact@marwentravel.com
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_GRAPH_API_VERSION="v23.0"
RESEND_API_KEY=""
NOTIFICATION_EMAIL_FROM="Marwen Travel <contact@marwentravel.com>"

# ── Cloudinary (optional image CDN / optimisation) ──────────────────────────
# Set both values to store new uploads in Cloudinary's durable CDN. The upload
# endpoint reads them at runtime; rebuild after changing them for CDN image
# optimisation in the browser bundle as well.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
